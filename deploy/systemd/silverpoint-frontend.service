[Unit]
Description=SilverPoint POD Next.js Frontend Daemon
After=network.target silverpoint-backend.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/SP_Order_Flow/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c "npm run start"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
