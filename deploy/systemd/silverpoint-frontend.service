[Unit]
Description=SilverPoint POD Next.js Frontend Daemon
After=network.target silverpoint-backend.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/silverpoint/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
