# Django Core & Security
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=uUetjPgDLIixCH1L_nSOtJKqkAdXbwRVnDZL3Pax3bW14197URUbefuyTpK9RUiNztA
DEBUG=False

# Host & Allowed Domains
ALLOWED_HOSTS=orderflow.silverpointprint.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://orderflow.silverpointprint.com,http://orderflow.silverpointprint.com

# SSL / HTTPS Cookie Security
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
