# ==============================================================================
# SilverPoint POD - Production Environment Configuration (.env)
# ==============================================================================

# Server & Security
DJANGO_SECRET_KEY=generate_a_secure_random_64_character_string_here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip,localhost,backend
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PostgreSQL Database Configuration
DB_NAME=silverpoint_pod
DB_USER=silverpoint_user
DB_PASSWORD=strong_database_password_here

# Redis Broker (Docker network handles hostname 'redis')
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Printify POD REST API Integration
PRINTIFY_API_TOKEN=your_live_printify_personal_access_token
PRINTIFY_SHOP_ID=your_printify_shop_id
PRINTIFY_WEBHOOK_SECRET=your_printify_webhook_signing_secret

# Peecho Integration
PEECHO_API_BASE_URL=https://api.peecho.com
PEECHO_API_KEY=your_peecho_api_key
PEECHO_WEBHOOK_SECRET=your_peecho_webhook_secret

# Frontend Client Public API URL (relative or absolute)
NEXT_PUBLIC_API_URL=/api/v1
